{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "bg", "color": "#0E100D", "name": "Ink (background)" },
				{ "slug": "bg-raise", "color": "#161812", "name": "Ink Raised (card / band)" },
				{ "slug": "ink", "color": "#EDE6D3", "name": "Warm Cream (text)" },
				{ "slug": "ink-soft", "color": "#B8B09D", "name": "Ink Soft" },
				{ "slug": "ink-muted", "color": "#7A7566", "name": "Ink Muted" },
				{ "slug": "green", "color": "#1B5E3B", "name": "Brand Green" },
				{ "slug": "gold", "color": "#C9A96E", "name": "Temple Gold (accent)" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Playfair Display",
					"fontFamily": "\"Playfair Display\", \"Times New Roman\", Times, serif"
				},
				{
					"slug": "body",
					"name": "Crimson Pro",
					"fontFamily": "\"Crimson Pro\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "DM Mono",
					"fontFamily": "\"DM Mono\", ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, monospace"
				},
				{
					"slug": "script",
					"name": "Caveat",
					"fontFamily": "\"Caveat\", \"Brush Script MT\", cursive"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.35rem", "max": "1.6rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "40", "name": "2", "size": "clamp(1.5rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "3", "size": "clamp(3rem, 7vw, 6rem)" },
				{ "slug": "80", "name": "4", "size": "clamp(5rem, 10vw, 9rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--bg)", "text": "var(--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "var(--gold)" } },
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "500", "lineHeight": "1.08" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "500", "lineHeight": "1.08" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "500" } }
		}
	}
}
