{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "bg", "color": "#FAF8F3", "name": "Soft White" },
				{ "slug": "sand", "color": "#F5E9D3", "name": "Warm Sand" },
				{ "slug": "navy", "color": "#102A43", "name": "Mekong Navy" },
				{ "slug": "ink", "color": "#1F2933", "name": "Charcoal" },
				{ "slug": "gold", "color": "#B8893E", "name": "Temple Gold" },
				{ "slug": "green", "color": "#2F5D50", "name": "Jungle Green" },
				{ "slug": "clay", "color": "#C46A3A", "name": "Sunset Clay" },
				{ "slug": "ink-soft", "color": "#4A5560", "name": "Ink Soft" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Cormorant, Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "\"Manrope\", system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Manrope Label",
					"fontFamily": "\"Manrope\", system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "script",
					"name": "Caveat",
					"fontFamily": "\"Caveat\", ui-rounded, cursive"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.35rem", "max": "1.6rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "40", "name": "2", "size": "clamp(1.5rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "3", "size": "clamp(3rem, 7vw, 6rem)" },
				{ "slug": "80", "name": "4", "size": "clamp(5rem, 10vw, 9rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--bg)", "text": "var(--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": { "color": { "text": "var(--gold)" } },
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "500", "lineHeight": "1.05" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "500", "lineHeight": "1.1" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "500" } }
		}
	}
}
