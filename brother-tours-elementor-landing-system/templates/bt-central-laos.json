										},
										{
											"id": "393fca7",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Five to eight days covers the region properly. Four is enough for Vientiane and Vang Vieng alone; Kong Lor needs its own overnight.</p>"
											},
											"elements": []
										}
									],
									"isInner": false
