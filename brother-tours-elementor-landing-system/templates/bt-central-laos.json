						{
							"id": "78915af",
							"elType": "widget",
							"widgetType": "accordion",
							"settings": {
								"tabs": [
									{
										"_id": "863fb00",
										"tab_title": "Is Vang Vieng still a party town?",
										"tab_content": "<p>No. That period ended years ago. It is now a landscape destination — caving, kayaking, climbing, ballooning and viewpoints.</p>"
									},
									{
										"_id": "801a1c0",
										"tab_title": "How long does Kong Lor take?",
										"tab_content": "<p>The passage is roughly 7.5 km each way by boat and takes the better part of a morning with stops. Getting there is the longer part of the day, which is why we build an overnight around it.</p>"
									},
									{
										"_id": "41e1958",
										"tab_title": "Can we use the railway?",
										"tab_content": "<p>The Lao-China Railway, open since December 2021, runs through this corridor and makes Vientiane–Vang Vieng–Luang Prabang short. We advise on whether it beats driving for your particular route.</p>"
									},
									{
										"_id": "49ea9b5",
										"tab_title": "Is Central Laos good for a first trip to Laos?",
										"tab_content": "<p>Yes — short transfers, a capital city, the best karst in the country and a genuinely unusual cave, all within a few hours of each other.</p>"
									},
									{
										"_id": "d76fe04",
										"tab_title": "What does it cost?",
										"tab_content": "<p>Price is confirmed on request once the route and standard of accommodation are settled.</p>"
									}
								],
								"title_html_tag": "h3",
								"_css_classes": "bt-landing-faq"
							},
							"elements": []
						}
					],
					"isInner": false
				}
			],
