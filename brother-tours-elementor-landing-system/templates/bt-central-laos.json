											"elements": []
										},
										{
											"id": "85c4c17",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>November to February is dry and cool. Kong Lor is best when water levels allow the full passage — that varies through the year, and we check it before confirming the day.</p>"
											},
											"elements": []
										}
									],
									"isInner": false
