											"elType": "widget",
											"widgetType": "heading",
											"settings": {
												"title": "Pace",
												"header_size": "h3",
												"_css_classes": "bt-landing-planning__label"
											},
											"elements": []
										},
										{
											"id": "a2dd9b3",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Short transfers make this an easy region to travel slowly. Two nights per stop is usually better than three stops in four days.</p>"
											},
											"elements": []
										}
									],
									"isInner": false
								},
								{
									"id": "133493d",
