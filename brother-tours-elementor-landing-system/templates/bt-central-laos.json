						"_css_classes": "wrap"
					},
					"elements": [
						{
							"id": "5d33a68",
							"elType": "widget",
							"widgetType": "heading",
							"settings": {
								"title": "Ken's note",
								"header_size": "p",
								"_css_classes": "eyebrow"
							},
							"elements": []
						},
						{
							"id": "8545df3",
							"elType": "widget",
							"widgetType": "text-editor",
							"settings": {
								"editor": "<p>People give Vang Vieng one night because of what they read about it a decade ago. That is the wrong length. Give it two and go up a mountain in the morning, and it becomes the best-looking place in the country.</p>\n<p>Kong Lor deserves its own overnight rather than a rushed day trip. Arriving the evening before means going through the cave early, when the river is quiet and the boatmen are not working around a schedule.</p>",
								"_css_classes": "bt-landing-insight__body"
							},
							"elements": []
						},
						{
							"id": "984292e",
							"elType": "widget",
							"widgetType": "text-editor",
							"settings": {
								"editor": "<p>Ken FJ Her — founder, Brother Tours. Licensed Lao National Tour Guide since 2010; founded Brother Tours in 2018.</p>",
								"_css_classes": "bt-landing-insight__attribution"
							},
							"elements": []
						}
					],
					"isInner": false
				}
