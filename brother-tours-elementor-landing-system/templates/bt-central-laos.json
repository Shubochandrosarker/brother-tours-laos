											"size": 8,
											"column": "8",
											"row": "8",
											"isLinked": true
										},
										"_css_classes": "bt-landing-col bt-landing-planning__item"
									},
									"elements": [
										{
											"id": "09f33cd",
											"elType": "widget",
											"widgetType": "heading",
											"settings": {
												"title": "Combining it",
												"header_size": "h3",
												"_css_classes": "bt-landing-planning__label"
											},
											"elements": []
										},
										{
											"id": "8a774d0",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Central Laos pairs naturally with Luang Prabang to the north, or continues south towards the Bolaven Plateau and Si Phan Don.</p>"
											},
											"elements": []
