											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>November to February is dry and cool, and the most popular. March to May is hot. The green season, roughly June to October, is quieter and dramatic, with warm rain that usually falls in the afternoon rather than all day.</p>"
											},
