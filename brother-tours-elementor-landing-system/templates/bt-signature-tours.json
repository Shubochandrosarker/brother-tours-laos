										"tab_title": "How is this different from the Founder-Hosted page?",
										"tab_content": "<p>Founder-hosted journeys are a small subset of Signature journeys on which Ken travels with you personally. This page is the wider collection.</p>"
									},
									{
										"_id": "ff3b08c",
										"tab_title": "Can we change the itinerary?",
										"tab_content": "<p>Yes, in any direction. It is a designed starting point, not a fixed product.</p>"
									},
									{
										"_id": "09b3481",
										"tab_title": "Are these group departures?",
										"tab_content": "<p>No. Every journey is private to your party.</p>"
