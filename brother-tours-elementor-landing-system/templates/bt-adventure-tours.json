											"elements": []
										},
										{
											"id": "0b96801",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>November to February is dry and cool — the easiest walking weather. March to May is hot. The green season, roughly June to October, brings full rivers and dramatic light, with some trails harder going and some roads slower.</p>"
											},
											"elements": []
										}
									],
									"isInner": false
