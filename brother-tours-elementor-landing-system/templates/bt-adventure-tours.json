										},
										{
											"id": "8c15c66",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Anyone in ordinary health who walks regularly. Tell us honestly what you are happy with and the route is built to it — including where a rest day should fall.</p>"
