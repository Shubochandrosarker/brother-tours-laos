										},
										{
											"id": "39f1bf0",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Active days are usually three to six hours of walking or paddling, with the rest of the day unstructured. Consecutive hard days are a choice, not a default.</p>"
											},
											"elements": []
										}
									],
									"isInner": false
