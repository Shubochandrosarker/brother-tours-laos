										},
										{
											"id": "53ba36a",
											"elType": "widget",
											"widgetType": "text-editor",
											"settings": {
												"editor": "<p>Private vehicle between regions, boats where the river is the better road, and the Lao-China Railway on the Vientiane–Luang Prabang corridor where it saves a long drive.</p>"
											},
											"elements": []
