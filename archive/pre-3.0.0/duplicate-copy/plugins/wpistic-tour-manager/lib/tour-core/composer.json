{
    "name": "wpistic/tour-core",
    "description": "Framework-agnostic tour, booking, pricing and payment domain for Brother Tours. No WordPress, no Laravel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Wpistic\\TourCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wpistic\\TourCore\\Tests\\": "tests/"
        }
    }
}
